# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# MVP hardcoded local-dev account (CLAUDE.md section 5) - never treat as
# production authentication.
CONFIGLENS_AUTH_USERNAME=user
CONFIGLENS_AUTH_PASSWORD=password

# Symmetric key used to sign/validate JWTs issued at login. Use a long,
# random value - this is a secret, keep it out of source control.
CONFIGLENS_JWT_SIGNING_KEY=change-this-to-a-long-random-value

# Origin the backend's CORS policy allows (must match where the frontend is
# actually served from).
CONFIGLENS_FRONTEND_ORIGIN=http://localhost:5173

# Base URL the frontend calls for the API - baked into the frontend
# container's runtime env-config.js at start, not into the image itself.
CONFIGLENS_API_BASE_URL=http://localhost:5080

# Azure service principal for the AKS Deployment Scan only (Azure.Identity's
# DefaultAzureCredential reads these exact names - see README.md "AKS Deployment
# Scan prerequisites" for how to create one). Leave blank to run ConfigLens with
# every other scan category still fully working on sample data.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
